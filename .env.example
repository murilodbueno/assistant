# Modelo de IA principal (qualquer API compatível com OpenAI; o padrão é o Vercel AI Gateway)
LLM_API_KEY=
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=openai/gpt-4.1-mini
LLM_TIMEOUT_SEC=30

# Modelo reserva, usado quando o principal falha (ex.: NVIDIA Nemotron)
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_LLM_MODEL=
FALLBACK_LLM_TIMEOUT_SEC=30

# WAHA (conexão do WhatsApp por QR code)
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Mesma chave configurada em WHATSAPP_HOOK_HMAC_KEY no WAHA
WAHA_HMAC_KEY=

# Google Agenda (conta de serviço com a agenda do dono compartilhada)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_CALENDAR_ID=

# WhatsApp pessoal do dono: avisos de clientes + painel de configuracao (configurar, preco..., etc.)
OWNER_PHONE=

# Horas que o bot fica calado numa conversa depois que o dono responde por ela
BOT_PAUSE_HOURS=12
# Segundos esperando o cliente terminar de digitar antes de responder
DEBOUNCE_SEC=2
# Janela de envio dos lembretes (horas locais)
REMINDER_START_HOUR=9
REMINDER_END_HOUR=19

# Template do nicho em business/ (ex.: business/salao.yaml)
BUSINESS_FILE=business/salao.yaml
DB_PATH=data/assistant.db
TIMEZONE=America/Sao_Paulo
